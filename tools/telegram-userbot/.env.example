# Telegram userbot exporter — fill in and copy to .env (NEVER commit .env).
# Get API_ID and API_HASH at https://my.telegram.org -> API development tools.
TG_API_ID=
TG_API_HASH=

# Session file name (creates <name>.session — keep it SECRET, it's a login).
TG_SESSION=tg_userbot

# How many recent messages to pull per chat.
TG_PER_CHAT_LIMIT=300

# 1 = personal DMs only (recommended); 0 = include groups/channels too.
TG_USERS_ONLY=1

# Output dump path (gitignored).
TG_OUT=export/telegram_dump.json
